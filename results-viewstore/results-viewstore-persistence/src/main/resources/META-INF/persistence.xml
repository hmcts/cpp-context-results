<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="results-persistence-unit" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>java:/DS.results</jta-data-source>
        <class>uk.gov.moj.cpp.results.persist.entity.HearingResult</class>
        <class>uk.gov.moj.cpp.results.persist.entity.ResultPrompt</class>
        <class>uk.gov.moj.cpp.results.persist.entity.HearingDefendant</class>
        <class>uk.gov.moj.cpp.results.persist.entity.Hearing</class>
        <properties>
            <!-- Allow Hibernate's HQL row-value-constructor / tuple IN extension used by
                 InformantRegisterRepository (greatest-per-group queries carried over from the original
                 DeltaSpike @Query). Hibernate 7's strict JPA compliance would otherwise reject them with
                 StrictJpaComplianceViolation. -->
            <property name="hibernate.jpa.compliance.query" value="false"/>
        </properties>
    </persistence-unit>

</persistence>